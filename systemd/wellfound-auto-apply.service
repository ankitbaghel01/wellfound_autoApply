[Unit]
Description=Wellfound Auto-Apply Job
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/run/media/jeet/New\ Volume/My-Projects/wellfound
ExecStart=/run/media/jeet/New\ Volume/My-Projects/wellfound/scheduler.sh
TimeoutStartSec=7200
Nice=10

[Install]
WantedBy=multi-user.target
