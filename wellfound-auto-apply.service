[Unit]
Description=Wellfound Auto Apply - Daily Job Applications
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/run/media/jeet/New Volume/wellfound
ExecStart=/usr/bin/node auto-apply-runner.js wellfound --live
Environment=HOME=/home/jeet
TimeoutStartSec=6600
StandardOutput=append:/run/media/jeet/New Volume/wellfound/cron.log
StandardError=append:/run/media/jeet/New Volume/wellfound/cron.log

[Install]
WantedBy=multi-user.target
